<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clube.Mobile.Views.RegisterPage"
             Title="Autocadastro de Associado">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10" MaximumWidthRequest="520" HorizontalOptions="Center">
            <Label Text="Solicitar Associacao ao Clube" FontSize="20" FontAttributes="Bold" />
            <Label Text="O cadastro fica Pendente ate aprovacao do Presidente." FontSize="12" TextColor="#64748B" />

            <Label Text="Clube" FontSize="12" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Clubes}" SelectedItem="{Binding ClubeSelecionado}" />

            <Label Text="Tipo de Associado" FontSize="12" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding TiposAssociado}" SelectedItem="{Binding TipoSelecionado}" />

            <Label Text="Nome Completo" FontSize="12" FontAttributes="Bold" />
            <Entry Text="{Binding Nome}" Placeholder="Seu nome completo" />

            <Label Text="CPF (validacao algoritmica)" FontSize="12" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding Cpf}" Placeholder="000.000.000-00" />
                <Button Grid.Column="1" Text="Gerar Valido" Command="{Binding GerarCpfValidoCommand}" />
            </Grid>

            <Label Text="E-mail" FontSize="12" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="email@exemplo.com" />

            <Label Text="Telefone" FontSize="12" FontAttributes="Bold" />
            <Entry Text="{Binding Telefone}" />

            <Label Text="Senha de Acesso" FontSize="12" FontAttributes="Bold" />
            <Entry Text="{Binding Senha}" IsPassword="True" />

            <Label Text="Interesses (Pesca, Caca, Comida, Bebida...)" FontSize="12" FontAttributes="Bold" />
            <Entry Text="{Binding Interesses}" />

            <Label Text="Cidade / UF" FontSize="12" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,80" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding Cidade}" />
                <Entry Grid.Column="1" Text="{Binding Uf}" MaxLength="2" />
            </Grid>

            <Label Text="{Binding Mensagem}" FontSize="13" TextColor="#1D4ED8" FontAttributes="Bold" />

            <Button Text="Enviar Cadastro para Aprovacao"
                    Command="{Binding EnviarCadastroCommand}"
                    BackgroundColor="#15803D"
                    TextColor="White"
                    FontAttributes="Bold" />

            <Button Text="Voltar ao Login"
                    Command="{Binding VoltarCommand}"
                    BackgroundColor="#E2E8F0"
                    TextColor="#1E293B" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
