<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Clube.Mobile.Views"
             x:Class="Clube.Mobile.Views.PerfilPage"
             Title="Perfil &amp; Dependentes">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="10">
            <views:NetworkStatusBar />

            <Border Padding="14" Stroke="#CBD5E1" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding NomeUsuario}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding CpfUsuario, StringFormat='CPF: {0}'}" FontSize="12" TextColor="#475569" />
                    <Label Text="{Binding ClubeNome, StringFormat='Clube: {0}'}" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding TipoAssociadoTexto, StringFormat='Categoria: {0}'}" FontSize="13" />
                    <Label Text="{Binding StatusAprovacaoTexto, StringFormat='Status Cadastro: {0}'}" FontSize="13" />
                    <Label Text="{Binding DireitoAVotoTexto}" TextColor="{Binding CorDireitoAVoto}" FontAttributes="Bold" FontSize="14" Margin="0,4,0,0" />
                    <Label Text="{Binding Interesses, StringFormat='Interesses: {0}'}" FontSize="12" TextColor="#475569" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding MensagemStatus}" FontSize="12" TextColor="#0369A1" FontAttributes="Bold" />

            <Border Padding="12" Stroke="#CBD5E1" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Adicionar Dependente" FontAttributes="Bold" FontSize="15" />
                    <Entry Text="{Binding DepNome}" Placeholder="Nome do dependente" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding DepCpf}" Placeholder="CPF do dependente" />
                        <Button Grid.Column="1" Text="Gerar Valido" Command="{Binding GerarCpfDependenteCommand}" />
                    </Grid>
                    <Picker ItemsSource="{Binding GrausParentesco}" SelectedItem="{Binding DepParentesco}" />
                    <Entry Text="{Binding DepEmail}" Placeholder="E-mail do dependente" Keyboard="Email" />
                    <Button Text="Cadastrar Dependente"
                            Command="{Binding AdicionarDependenteCommand}"
                            BackgroundColor="#1D4ED8"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Dependentes Vinculados" FontAttributes="Bold" FontSize="15" />
            <CollectionView ItemsSource="{Binding Dependentes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="10" Stroke="#E2E8F0" BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding GrauParentesco, StringFormat='Parentesco: {0}'}" FontSize="12" />
                                <Label Text="{Binding CPF, StringFormat='CPF: {0}'}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Trocar Conta / Sair"
                    Command="{Binding SairCommand}"
                    BackgroundColor="#DC2626"
                    TextColor="White"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
