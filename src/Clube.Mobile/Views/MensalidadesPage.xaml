<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Clube.Mobile.Views"
             x:Class="Clube.Mobile.Views.MensalidadesPage"
             Title="Mensalidades">
    <Grid RowDefinitions="Auto,Auto,*" Padding="14" RowSpacing="8">
        <views:NetworkStatusBar Grid.Row="0" />

        <Label Grid.Row="1" Text="{Binding MensagemStatus}" FontSize="12" TextColor="#15803D" FontAttributes="Bold" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Mensalidades}">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma mensalidade carregada. Faca login online e clique em Sincronizar."
                       HorizontalTextAlignment="Center"
                       TextColor="#64748B"
                       Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="12" Stroke="#CBD5E1" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Competencia, StringFormat='Competencia: {0}'}" FontAttributes="Bold" FontSize="15" />
                            <Label Text="{Binding Valor, StringFormat='Valor: R$ {0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#1E3A8A" />
                            <Label Text="{Binding DataVencimento, StringFormat='Vencimento: {0:dd/MM/yyyy}'}" FontSize="12" />
                            <Label Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="12" FontAttributes="Bold" />
                            <Label Text="{Binding CodigoPixCopiaECola}" FontSize="10" TextColor="#475569" LineBreakMode="CharacterWrap" />
                            <Button Text="Copiar Codigo PIX Copia-e-Cola"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopiarPixCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#15803D"
                                    TextColor="White"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
