<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clube.Mobile.Views.LoginPage"
             Title="Projeto Clubes — Acesso"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Projeto Clubes"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1E3A8A"
                   HorizontalTextAlignment="Center" />
            <Label Text="Aplicativo do Associado (Offline-First)"
                   FontSize="14"
                   TextColor="#64748B"
                   HorizontalTextAlignment="Center" />

            <Border Stroke="#CBD5E1" Padding="16" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="CPF" FontSize="12" FontAttributes="Bold" />
                    <Entry Text="{Binding Cpf}" Placeholder="000.000.000-00" />

                    <Label Text="Senha" FontSize="12" FontAttributes="Bold" />
                    <Entry Text="{Binding Senha}" IsPassword="True" />

                    <Label Text="{Binding MensagemErro}"
                           TextColor="#DC2626"
                           FontSize="12" />

                    <Button Text="Entrar (Online API)"
                            Command="{Binding EntrarCommand}"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold" />

                    <Button Text="Entrar Offline (Cache SQLite)"
                            Command="{Binding EntrarOfflineCommand}"
                            BackgroundColor="#0F766E"
                            TextColor="White" />

                    <Button Text="Novo Cadastro (Autocadastro)"
                            Command="{Binding IrParaCadastroCommand}"
                            BackgroundColor="#E2E8F0"
                            TextColor="#1E293B" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E2E8F0" Padding="14" BackgroundColor="#F8FAFC">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Preenchimento Rapido (Demonstracao)" FontAttributes="Bold" FontSize="13" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Text="Fundador (Com Voto)"
                                Command="{Binding PreencherDemoCommand}" CommandParameter="fundador"
                                FontSize="11" BackgroundColor="#2563EB" TextColor="White" />
                        <Button Grid.Row="0" Grid.Column="1" Text="Convidado (Sem Voto)"
                                Command="{Binding PreencherDemoCommand}" CommandParameter="convidado"
                                FontSize="11" BackgroundColor="#475569" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="0" Text="Simpatizante"
                                Command="{Binding PreencherDemoCommand}" CommandParameter="simpatizante"
                                FontSize="11" BackgroundColor="#7C3AED" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Presidente Foz"
                                Command="{Binding PreencherDemoCommand}" CommandParameter="presidente"
                                FontSize="11" BackgroundColor="#059669" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
