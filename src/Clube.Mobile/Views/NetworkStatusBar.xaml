<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clube.Mobile.Views.NetworkStatusBar">
    <Border BackgroundColor="{Binding CorStatusRede}"
            StrokeThickness="0"
            Padding="12,8"
            Margin="0,0,0,10">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="{Binding TextoStatusRede}"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="12" />
                <Label Text="{Binding PendenciasOutbox, StringFormat='Outbox pendente: {0} item(ns)'}"
                       TextColor="#F1F5F9"
                       FontSize="11" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="{Binding TextoBotaoModoRede}"
                    Command="{Binding AlternarModoOfflineCommand}"
                    BackgroundColor="#1E293B"
                    TextColor="White"
                    FontSize="11"
                    Padding="10,4"
                    HeightRequest="34" />

            <Button Grid.Column="2"
                    Text="Sincronizar"
                    Command="{Binding SincronizarAgoraCommand}"
                    BackgroundColor="#0284C7"
                    TextColor="White"
                    FontSize="11"
                    Padding="10,4"
                    HeightRequest="34" />
        </Grid>
    </Border>
</ContentView>
