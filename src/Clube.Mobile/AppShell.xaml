<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Clube.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Clube.Mobile.Views"
    Title="Projeto Clubes">

    <ShellContent
        Title="Acesso"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        FlyoutItemIsVisible="False" />

    <TabBar>
        <ShellContent Title="Eventos" ContentTemplate="{DataTemplate views:EventosPage}" Route="EventosPage" />
        <ShellContent Title="Reservas" ContentTemplate="{DataTemplate views:ReservasPage}" Route="ReservasPage" />
        <ShellContent Title="Mensalidades" ContentTemplate="{DataTemplate views:MensalidadesPage}" Route="MensalidadesPage" />
        <ShellContent Title="SAC" ContentTemplate="{DataTemplate views:SacPage}" Route="SacPage" />
        <ShellContent Title="Perfil" ContentTemplate="{DataTemplate views:PerfilPage}" Route="PerfilPage" />
    </TabBar>

</Shell>
