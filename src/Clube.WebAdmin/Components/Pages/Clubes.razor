@page "/clubes"
@inject AdminSessionState Session
@inject IClubeService ClubeService
@implements IDisposable

<PageTitle>Clubes da Federacao — SuperAdmin</PageTitle>

<h3>Clubes da Federacao (Multi-Tenant)</h3>

@if (!Session.PodeGerenciarClubes)
{
    <div class="alert alert-warning">
        Apenas o perfil <strong>SuperAdmin</strong> pode cadastrar ou editar clubes da federacao.
        Use o seletor rapido no topo para alternar para <strong>SuperAdmin</strong>.
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_mensagem))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @_mensagem
            <button type="button" class="btn-close" @onclick="() => _mensagem = null"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">
            @(_editandoId.HasValue ? "Editar Clube" : "Novo Clube")
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small">Nome do Clube</label>
                    <input class="form-control form-control-sm" @bind="_nome" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Sigla</label>
                    <input class="form-control form-control-sm" @bind="_sigla" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Cidade</label>
                    <input class="form-control form-control-sm" @bind="_cidade" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small">UF</label>
                    <input class="form-control form-control-sm" @bind="_uf" maxlength="2" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Mensalidade (R$)</label>
                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="_valorMensalidade" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Endereco</label>
                    <input class="form-control form-control-sm" @bind="_endereco" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Bairro</label>
                    <input class="form-control form-control-sm" @bind="_bairro" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Telefone</label>
                    <input class="form-control form-control-sm" @bind="_telefone" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">E-mail</label>
                    <input class="form-control form-control-sm" @bind="_email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Chave PIX</label>
                    <input class="form-control form-control-sm" @bind="_chavePix" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Tipo Chave PIX</label>
                    <select class="form-select form-select-sm" @bind="_tipoChavePix">
                        @foreach (var tipo in Enum.GetValues<TipoChavePix>())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
                <div class="col-md-5 d-flex align-items-end gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="SalvarAsync">
                        @(_editandoId.HasValue ? "Atualizar Clube" : "Cadastrar Clube")
                    </button>
                    @if (_editandoId.HasValue)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LimparFormulario">Cancelar</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Sigla</th>
                    <th>Cidade/UF</th>
                    <th>Chave PIX</th>
                    <th>Mensalidade Padrao</th>
                    <th>Status</th>
                    <th>Acoes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _clubes)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nome</td>
                        <td><span class="badge bg-secondary">@c.Sigla</span></td>
                        <td>@c.Cidade/@c.UF</td>
                        <td><span class="small">@c.TipoChavePix: @c.ChavePix</span></td>
                        <td>R$ @c.ValorMensalidadePadrao.ToString("N2")</td>
                        <td>
                            <span class="badge @(c.Ativo ? "bg-success" : "bg-danger")">
                                @(c.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(c)">Editar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClubeDto> _clubes = [];
    private Guid? _editandoId;
    private string _nome = string.Empty;
    private string _sigla = string.Empty;
    private string _endereco = string.Empty;
    private string _bairro = string.Empty;
    private string _cidade = string.Empty;
    private string _uf = "PR";
    private string _telefone = string.Empty;
    private string _email = string.Empty;
    private string _chavePix = string.Empty;
    private TipoChavePix _tipoChavePix = TipoChavePix.CNPJ;
    private decimal _valorMensalidade = 150.00m;
    private string? _mensagem;

    protected override async Task OnInitializedAsync()
    {
        Session.OnSessionChanged += HandleSessionChanged;
        await LoadAsync();
    }

    private async void HandleSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        Session.AplicarNoEscopo();
        _clubes = await ClubeService.ListarAsync();
    }

    private void Editar(ClubeDto c)
    {
        _editandoId = c.Id;
        _nome = c.Nome;
        _sigla = c.Sigla;
        _endereco = c.Endereco;
        _bairro = c.Bairro;
        _cidade = c.Cidade;
        _uf = c.UF;
        _telefone = c.Telefone;
        _email = c.Email;
        _chavePix = c.ChavePix;
        _tipoChavePix = c.TipoChavePix;
        _valorMensalidade = c.ValorMensalidadePadrao;
    }

    private void LimparFormulario()
    {
        _editandoId = null;
        _nome = _sigla = _endereco = _bairro = _cidade = _telefone = _email = _chavePix = string.Empty;
        _uf = "PR";
        _valorMensalidade = 150.00m;
    }

    private async Task SalvarAsync()
    {
        Session.AplicarNoEscopo();
        var req = new SalvarClubeRequest(
            _nome, _sigla, _endereco, _bairro, _cidade, _uf,
            _telefone, _email, _chavePix, _tipoChavePix, _valorMensalidade);

        if (_editandoId.HasValue)
        {
            await ClubeService.AtualizarAsync(_editandoId.Value, req);
            _mensagem = "Clube atualizado com sucesso.";
        }
        else
        {
            await ClubeService.CriarAsync(req);
            _mensagem = "Novo clube cadastrado com sucesso.";
        }

        LimparFormulario();
        await LoadAsync();
    }

    public void Dispose() => Session.OnSessionChanged -= HandleSessionChanged;
}
