@page "/eventos"
@inject AdminSessionState Session
@inject IEventoService EventoService
@inject IAssociadoService AssociadoService
@implements IDisposable

<PageTitle>Eventos Sociais — Projeto Clubes</PageTitle>

<h3>Eventos Sociais &amp; Confirmacao de Presenca (RSVP)</h3>

@if (!string.IsNullOrEmpty(_feedback))
{
    <div class="alert @(_erro ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @_feedback
        <button type="button" class="btn-close" @onclick="() => _feedback = null"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Criar Novo Evento</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label small">Titulo</label>
                <input class="form-control form-control-sm" @bind="_titulo" placeholder="Ex: Feijoada Beneficente" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Tipo de Evento</label>
                <select class="form-select form-select-sm" @bind="_tipo">
                    @foreach (var t in Enum.GetValues<TipoEvento>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Publico-Alvo</label>
                <select class="form-select form-select-sm" @bind="_publico">
                    @foreach (var p in Enum.GetValues<PublicoAlvoEvento>())
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Ingresso (R$)</label>
                <input type="number" step="0.01" class="form-control form-control-sm" @bind="_valor" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Data/Hora Inicio</label>
                <input type="datetime-local" class="form-control form-control-sm" @bind="_inicio" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Data/Hora Fim</label>
                <input type="datetime-local" class="form-control form-control-sm" @bind="_fim" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Local</label>
                <input class="form-control form-control-sm" @bind="_local" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-sm btn-primary w-100" @onclick="CriarEventoAsync">Criar Evento</button>
            </div>
            <div class="col-12">
                <input class="form-control form-control-sm" @bind="_descricao" placeholder="Descricao do evento..." />
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var ev in _eventos)
    {
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title mb-1">@ev.Titulo</h5>
                            <span class="badge bg-info text-dark me-1">@ev.TipoEvento</span>
                            <span class="badge bg-secondary">@ev.PublicoAlvo</span>
                        </div>
                        <span class="badge bg-success">RSVP: @ev.TotalConfirmados</span>
                    </div>
                    <p class="card-text small text-muted mt-2">@ev.Descricao</p>
                    <div class="small">
                        <strong>Periodo:</strong> @ev.DataInicio.ToString("dd/MM/yyyy HH:mm") ate @ev.DataFim.ToString("dd/MM/yyyy HH:mm")<br />
                        <strong>Local:</strong> @ev.Local | <strong>Valor:</strong> R$ @ev.ValorIngresso.ToString("N2")
                    </div>

                    <div class="mt-3 pt-2 border-top d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm" @bind="_associadoParaRsvp">
                            @foreach (var a in _associados)
                            {
                                <option value="@a.Id">@a.Nome (@a.TipoAssociado)</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="() => TestarRsvpAsync(ev.Id)">
                            Confirmar RSVP
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<EventoDto> _eventos = [];
    private List<AssociadoDto> _associados = [];
    private Guid _associadoParaRsvp;

    private string _titulo = string.Empty;
    private string _descricao = "Evento social do clube.";
    private TipoEvento _tipo = TipoEvento.FeijoadaBeneficente;
    private PublicoAlvoEvento _publico = PublicoAlvoEvento.AbertoAoPublico;
    private DateTime _inicio = DateTime.Today.AddDays(30).AddHours(11);
    private DateTime _fim = DateTime.Today.AddDays(30).AddHours(17);
    private string _local = "Salao Social Principal";
    private decimal _valor = 60.00m;

    private string? _feedback;
    private bool _erro;

    protected override async Task OnInitializedAsync()
    {
        Session.OnSessionChanged += HandleSessionChanged;
        await LoadAsync();
    }

    private async void HandleSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        Session.AplicarNoEscopo();
        _eventos = await EventoService.ListarAsync();
        _associados = await AssociadoService.ListarAsync();
        if (_associados.Count > 0 && _associados.All(a => a.Id != _associadoParaRsvp))
        {
            _associadoParaRsvp = _associados[0].Id;
        }
    }

    private async Task CriarEventoAsync()
    {
        try
        {
            _erro = false;
            Session.AplicarNoEscopo();
            var clubeId = Session.ClubeId ?? _associados.FirstOrDefault()?.ClubeId ?? Guid.Empty;
            await EventoService.CriarAsync(new CriarEventoRequest(
                clubeId, _titulo, _descricao, _tipo, _publico, _inicio, _fim, _local, _valor));
            _titulo = string.Empty;
            _feedback = "Evento criado com sucesso.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _erro = true;
            _feedback = ex.Message;
        }
    }

    private async Task TestarRsvpAsync(Guid eventoId)
    {
        try
        {
            _erro = false;
            Session.AplicarNoEscopo();
            var insc = await EventoService.InscreverAsync(eventoId, new InscreverEventoRequest(_associadoParaRsvp, 1));
            _feedback = $"RSVP confirmado para {insc.AssociadoNome} (+1 acompanhante).";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _erro = true;
            _feedback = ex.Message;
        }
    }

    public void Dispose() => Session.OnSessionChanged -= HandleSessionChanged;
}
