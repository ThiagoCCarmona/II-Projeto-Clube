@inject AdminSessionState Session
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">Projeto Clubes</a>
    </div>
</div>

<input type="checkbox" title="Menu de navegacao" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Dashboard
            </NavLink>
        </div>

        @if (Session.PodeGerenciarClubes)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="clubes">
                    Clubes (Federacao)
                </NavLink>
            </div>
        }

        @if (Session.PodeGerenciarAssociadosEReservas)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="associados">
                    Associados &amp; Voto
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reservas">
                    Espacos &amp; Reservas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="eventos">
                    Eventos Sociais
                </NavLink>
            </div>
        }

        @if (Session.PodeGerenciarFinanceiro)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="financeiro">
                    Financeiro &amp; PIX
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="solicitacoes">
                SAC / Ouvidoria
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnSessionChanged += OnSessionUpdated;
    }

    private void OnSessionUpdated() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnSessionChanged -= OnSessionUpdated;
    }
}
